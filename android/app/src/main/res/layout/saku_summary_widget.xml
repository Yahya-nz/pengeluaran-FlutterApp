<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/saku_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="8dp"
    android:background="@drawable/saku_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SAKU"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Total Saldo"
        android:textColor="#D6E8FF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/saku_widget_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Rp 12.000.000"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/saku_widget_detail_background"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengeluaran bulan ini"
            android:textColor="#475467"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/saku_widget_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 75.000"
            android:textColor="#EA4655"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/saku_widget_latest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Makanan - 30.000"
            android:textColor="#475467"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
